# Edge function secrets. Copy to supabase/functions/.env for local serving;
# for a hosted project use `supabase secrets set`.

# "fixture" serves built-in simulated Garmin data, "live" calls the Garmin API.
GARMIN_MODE=fixture
# Base URL of the Garmin API (live mode only).
GARMIN_API_BASE_URL=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts provider tokens at rest.
CREDENTIAL_ENCRYPTION_KEY=
